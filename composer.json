{
    "name": "sierratecnologia/telefonica",
    "description": "Telefonica - Modelos e entidades organizacionais e digitais do ecossistema",
    "type": "library",
    "keywords": [
        "sierratecnologia",
        "telefonica",
        "companies",
        "business",
        "sites"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "SierraTecnologia",
            "homepage": "https://sierratecnologia.com.br",
            "email": "help@sierratecnologia.com.br"
        },
        {
            "name": "Ricardo Rebello Sierra",
            "email": "contato@ricardosierra.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "sierratecnologia/muleta": "^2.0",
        "overtrue/laravel-follow": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage"
    },
    "autoload": {
        "psr-4": {
            "Telefonica\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Telefonica\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Telefonica\\TelefonicaProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../**",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "2.2.2"
}
